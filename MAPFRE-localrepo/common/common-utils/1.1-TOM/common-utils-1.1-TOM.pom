    <!--    <dependency>-->
    <!--      <groupId>commons-cli</groupId>-->
    <!--      <artifactId>commons-cli</artifactId>-->
    <!--      <version>1.1</version>-->
    <!--    </dependency>-->
    <dependency>
      <groupId>${pom.parent.groupId}</groupId>
      <artifactId>common-tests</artifactId>
      <version>${pom.parent.version}</version>
      <scope>test</scope>
    </dependency>

  <!--    <dependency>
      <groupId>${pom.parent.groupId}</groupId>
      <artifactId>i18n-Exception</artifactId>
